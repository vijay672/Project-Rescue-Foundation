# Project Rescue Foundation — Environment Configuration

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE CONFIGURATION (Auth, Database & Storage)
# ==============================================================================
# Browser-safe publishable URL & Anon Key for Supabase client
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_ANON_KEY=""

# Private Supabase Storage Bucket for Field Evidence (Strictly Private RLS)
VITE_SUPABASE_STORAGE_BUCKET="foundation-media"
SUPABASE_STORAGE_BUCKET="foundation-media"

# Privileged service role key (Server-side / Edge Functions only - NEVER expose in client)
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DB_URL=""

# ==============================================================================
# SERVER RUNTIME PORT
# ==============================================================================
PORT="3000"
